[sub_resource type="Shader" id=81]
code = "// this isnt perfect since dimming is still related to view and not the object's orientation

shader_type spatial;
render_mode async_visible,blend_mix,depth_draw_opaque,cull_back,diffuse_burley,specular_schlick_ggx;
uniform sampler2D texture_albedo : hint_albedo;
uniform sampler2D lcd : hint_albedo;
void fragment() {
	vec4 albedo_tex = texture(texture_albedo,vec2(UV.x,UV.y/14.0) -vec2(0.0,float(int(TIME*2.0))/14.0) );
	vec4 effect = texture(lcd,vec2(UV.x*128.0,UV.y*64.0)*10.5);
	ALBEDO *= 0.0;
	
	float dotted = dot(NORMAL,VIEW +vec3(0.0,+0.5,0.0)  );
	
	float yes = length(albedo_tex.rgb*effect.rgb);
	
	vec3 compensate = vec3(1.0 , 1.5 , 2.0);
	
	vec3 coler = albedo_tex.rgb*(length(albedo_tex.rgb));
	coler += vec3(0.05,0.05,0.05);
	
	EMISSION = (( (coler*compensate) *4.0)*dotted)*effect.rgb;
	METALLIC = yes;
	ROUGHNESS = 0.0;
	SPECULAR = 1.0 -yes;
	
	
}
"

